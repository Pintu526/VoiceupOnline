      uploading: "ÃƒÂ Ã‚Â¬Ã¢â‚¬Â¦ÃƒÂ Ã‚Â¬Ã‚ÂªÃƒÂ Ã‚Â¬Ã‚Â²ÃƒÂ Ã‚Â­Ã¢â‚¬Â¹ÃƒÂ Ã‚Â¬Ã‚Â¡ÃƒÂ Ã‚Â­Ã‚Â ÃƒÂ Ã‚Â¬Ã‚Â¹ÃƒÂ Ã‚Â­Ã¢â‚¬Â¡ÃƒÂ Ã‚Â¬Ã¢â‚¬Â°ÃƒÂ Ã‚Â¬Ã¢â‚¬ÂºÃƒÂ Ã‚Â¬Ã‚Â¿...",
      uploaded: "ÃƒÂ Ã‚Â¬Ã‹Å“ÃƒÂ Ã‚Â¬Ã‚Â°ÃƒÂ Ã‚Â­Ã¢â‚¬Â¹ÃƒÂ Ã‚Â¬Ã¢â‚¬Â¡ ÃƒÂ Ã‚Â¬Ã‚Â«ÃƒÂ Ã‚Â¬Ã…Â¸ÃƒÂ Ã‚Â­Ã¢â‚¬Â¹ ÃƒÂ Ã‚Â¬Ã¢â‚¬Â¦ÃƒÂ Ã‚Â¬Ã‚ÂªÃƒÂ Ã‚Â¬Ã‚Â²ÃƒÂ Ã‚Â­Ã¢â‚¬Â¹ÃƒÂ Ã‚Â¬Ã‚Â¡ÃƒÂ Ã‚Â­Ã‚Â ÃƒÂ Ã‚Â¬Ã‚Â¹ÃƒÂ Ã‚Â­Ã¢â‚¬Â¡ÃƒÂ Ã‚Â¬Ã‚Â²ÃƒÂ Ã‚Â¬Ã‚Â¾ÃƒÂ Ã‚Â¥Ã‚Â¤",
      invalidImage: "5 MB ÃƒÂ Ã‚Â¬Ã‚ÂªÃƒÂ Ã‚Â¬Ã‚Â°ÃƒÂ Ã‚Â­Ã‚ÂÃƒÂ Ã‚Â¬Ã‚Â¯ÃƒÂ Ã‚Â­Ã‚ÂÃƒÂ Ã‚Â­Ã…Â¸ÃƒÂ Ã‚Â¬Ã‚Â¨ÃƒÂ Ã‚Â­Ã‚ÂÃƒÂ Ã‚Â¬Ã‚Â¤ JPEG, PNG ÃƒÂ Ã‚Â¬Ã¢â‚¬Â¢ÃƒÂ Ã‚Â¬Ã‚Â¿ÃƒÂ Ã‚Â¬Ã‚Â®ÃƒÂ Ã‚Â­Ã‚ÂÃƒÂ Ã‚Â¬Ã‚Â¬ÃƒÂ Ã‚Â¬Ã‚Â¾ WebP ÃƒÂ Ã‚Â¬Ã¢â‚¬ÂºÃƒÂ Ã‚Â¬Ã‚Â¬ÃƒÂ Ã‚Â¬Ã‚Â¿ ÃƒÂ Ã‚Â¬Ã‚Â¬ÃƒÂ Ã‚Â¬Ã‚Â¾ÃƒÂ Ã‚Â¬Ã¢â‚¬ÂºÃƒÂ Ã‚Â¬Ã‚Â¨ÃƒÂ Ã‚Â­Ã‚ÂÃƒÂ Ã‚Â¬Ã‚Â¤ÃƒÂ Ã‚Â­Ã‚ÂÃƒÂ Ã‚Â¥Ã‚Â¤",
      uploadFailed: "ÃƒÂ Ã‚Â¬Ã‹Å“ÃƒÂ Ã‚Â¬Ã‚Â°ÃƒÂ Ã‚Â­Ã¢â‚¬Â¹ÃƒÂ Ã‚Â¬Ã¢â‚¬Â¡ ÃƒÂ Ã‚Â¬Ã‚Â«ÃƒÂ Ã‚Â¬Ã…Â¸ÃƒÂ Ã‚Â­Ã¢â‚¬Â¹ ÃƒÂ Ã‚Â¬Ã¢â‚¬Â¦ÃƒÂ Ã‚Â¬Ã‚ÂªÃƒÂ Ã‚Â¬Ã‚Â²ÃƒÂ Ã‚Â­Ã¢â‚¬Â¹ÃƒÂ Ã‚Â¬Ã‚Â¡ÃƒÂ Ã‚Â­Ã‚Â ÃƒÂ Ã‚Â¬Ã‚Â¬ÃƒÂ Ã‚Â¬Ã‚Â¿ÃƒÂ Ã‚Â¬Ã‚Â«ÃƒÂ Ã‚Â¬Ã‚Â³ÃƒÂ Ã‚Â¥Ã‚Â¤"
    }
  }
};

function isContinuingSamePublicPhoneIdentity(previousPhone: string, nextPhone: string): boolean {
  if (!previousPhone || !nextPhone) return false;
  return previousPhone.startsWith(nextPhone) || nextPhone.startsWith(previousPhone);
}

function shouldStartNewJourneyForPhoneInput(
  previousPhone: string,
  nextPhone: string,
  form: Pick<typeof blankSigner, "otpVerified" | "otpChallengeId" | "otpVerificationToken">
): boolean {
  if (previousPhone === nextPhone) return false;
  if (form.otpVerified || form.otpChallengeId || form.otpVerificationToken) return true;
  return !isContinuingSamePublicPhoneIdentity(previousPhone, nextPhone);
}

function useGeographyPreload(): void {
  useEffect(() => {
    if (typeof window === "undefined") return;

    let cancelled = false;

    const preload = () => {
      if (!cancelled) preloadIndiaLocationFields();
    };

    const timer = window.setTimeout(preload, 400);

    return () => {
      cancelled = true;
      window.clearTimeout(timer);
    };
  }, []);
}
export function PublicCampaignPage({
  campaign,
  organization,
  metrics,
  authority,
  authorities,
  campaignSigners,
  publicForm,
  setPublicForm,
  publicMessage,
  lastSignedSigner,
  supporterAccountClaimGrant = null,
  linkedSupporterAccount = null,
  onSupporterAccountLinked,
  otpInput,
  setOtpInput,
  otpMessage,
  onSendOtp,
  onVerifyOtp,
  onRetryVerifiedSupporterLookup = onVerifyOtp,
  locationOverrides,
  locationDeletions,
  customLocations = [],
  onGrowthShare,
  onUploadSupporterPhoto,
  onSaveDraft,
  onCommunicationConsentChange,
  onSubmitMovementRequest,
  movementRequests,
  movementRequestsLoading = false,
  movementRequestsError = "",
  onRefreshMovementRequests,
  onSubmitCoordinatorApplication,
  onStartNewJourney,
  onSubmit
}: PublicCampaignPageProps) {
  useGeographyPreload();
  const { language, t } = useTranslation();
  const premiumPresentation = getPublicCampaignPresentation(campaign.slug);
  const presentationCopy = premiumPresentation
    ? getPublicCampaignPresentationCopy(premiumPresentation, language)
    : null;
  const isGoudhanExperience =
    Boolean(premiumPresentation) &&
    isGoudhanProductionCampaign(campaign, organization);
  const isGaumataHost =
    typeof window !== "undefined" &&
    isGaumataPublicHostname(window.location.hostname);
  const isGaumataCampaignExperience = isGoudhanExperience && isGaumataHost;
  const campaignHeroImage = sanitizePublicCampaignMediaUrl(campaign.heroImage);
  const campaignSupportingArtwork =
    premiumPresentation &&
    campaignHeroImage === premiumPresentation.placeholderHeroAsset
      ? ""
      : campaignHeroImage;
  const campaignHeroArtwork = sanitizePublicCampaignMediaUrl(
    premiumPresentation?.heroAsset.trim() || campaignSupportingArtwork
  );
  const displayCampaign: Campaign = isGoudhanExperience
    ? {
        ...campaign,
        title: t("goudhanCampaign.title"),
        description: t("goudhanCampaign.summary"),
        appealContent: t("goudhanCampaign.appeal"),
        socialShareText: t("goudhanCampaign.share"),
        thankYouMessage: t("goudhanCampaign.thankYou"),
        qrLabel: t("goudhanCampaign.qrLabel"),
        consentText: t("goudhanCampaign.consent"),
        heroImage: campaignHeroImage
      }
    : {
        ...campaign,
        ...getLocalizedCampaignContent(campaign, language),
        heroImage: campaignHeroImage
      };
  const campaignAccountAccessPath = getCampaignLoginPath({
    campaignId: campaign.id,
    campaignSlug: campaign.slug
  });
  const publicOrganizationLabel = organization?.name?.trim() ?? "";
  const configuredAuthorityOptions = getAuthorityOptionsForCampaign(campaign, authorities);
  const publicAuthorityOptions = isGaumataCampaignExperience
    ? configuredAuthorityOptions
    : getPublicAuthorityOptions(campaign, authorities);
  const campaignConfiguredAuthority =
    getConfiguredAppealAuthority(campaign, authorities);
  const configuredAuthority = authority ?? campaignConfiguredAuthority;
  const hasConfiguredAuthority = Boolean(configuredAuthority);
  const showNeutralAuthority =
    isGaumataCampaignExperience && !hasConfiguredAuthority;
  const resolvedAuthority = configuredAuthority ?? getAppealAuthority(campaign);
  const isGlobalMode = getCampaignGeographyMode(campaign) === "global";
  const locationLabels = getCampaignLocationLabels(campaign);
  const signerRestrictionLevel = getEffectiveSignerLocationRestrictionLevel(campaign, organization);
  const restrictedPublicForm = applySignerLocationRestriction(campaign, publicForm, organization);
  const publicLocationForm =
    isGlobalMode && getCampaignScope(campaign) !== "global" && campaign.country && !restrictedPublicForm.country
      ? { ...restrictedPublicForm, country: campaign.country }
      : restrictedPublicForm;
  const restrictionMessage = getLocationRestrictionMessage(campaign, organization);
  const lockedLocation = {
    ...(isGlobalMode && getCampaignScope(campaign) !== "global" && campaign.country
      ? { country: campaign.country }
      : {}),
    ...getLockedLocationValues(campaign, signerRestrictionLevel)
  };
  const lockedLocationParts = formatLocationForCampaign(campaign, lockedLocation).split(", ").filter(Boolean);
  const publicIndiaAllowedLocation = lockedLocation.state?.trim() ? lockedLocation : undefined;
  const campaignCustomLocations = (campaign as Campaign & { customLocations?: unknown }).customLocations;
  const publicCampaignLocationCatalog = usePublicCampaignLocationCatalog(campaign.slug, publicLocationForm);
  const signerLocationCatalog = useMemo(
    () => resolveIndiaLocationCatalog(
      [...customLocations, ...publicCampaignLocationCatalog.locations],
      campaignCustomLocations
    ),
    [campaignCustomLocations, customLocations, publicCampaignLocationCatalog.locations]
  );
  const requiredFields = campaign.requiredFields ?? [];
  const copy = publicSigningCopy[language];
  const experienceCopy = publicExperienceCopy[language];
  const addressLabel = copy.addressLabel;
  const addressPlaceholder = copy.addressPlaceholder;
  const locationSectionTitle = isGoudhanExperience
    ? t("goudhanCampaign.locationTitle")
    : experienceCopy.locationTitle;
  const locationSectionHelp = isGoudhanExperience
    ? t("goudhanCampaign.locationHelp")
    : experienceCopy.locationHelp;
  const displayPublicMessage =
    publicMessage === "consent_required"
      ? t("public.consentRequiredInline")
      : publicMessage === "existing_supporter_duplicate"
        ? t("public.existingSupporterDuplicate")
        : publicMessage;
  const publicMessageIsError =
    publicMessage === "consent_required" ||
    publicMessage === "existing_supporter_duplicate" ||
    isPublicFailureMessage(displayPublicMessage);
  const safeOtpMessage = getSafeOtpDisplayMessage(otpMessage, {
    hostname: typeof window === "undefined" ? "" : window.location.hostname,
    isDevelopment: import.meta.env.DEV,
    explicitTestDisplayEnabled: import.meta.env.VITE_VOICEUP_SHOW_OTP === "true",
    neutralMessage: copy.otpHelp
  });
  const otpMessageIsError =
    safeOtpMessage.trim() !== copy.otpHelp.trim() && isPublicFailureMessage(safeOtpMessage);
  const signerFieldLabel = (label: string, field: SignerRequiredField) =>
    requiredFields.includes(field) ? `${label} *` : label;
  const prefersReducedMotion = useMemo(() => {
    if (typeof window === "undefined") return false;
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }, []);
  const [audioEnabled, setAudioEnabled] = useState(false);
  const mantraAudioRef = useRef<HTMLAudioElement | null>(null);
  const [monkpujaVideoIndex, setMonkpujaVideoIndex] = useState(0);
  const monkpujaVideoSources = ["/assets/gemini_generated_video_4.mp4"] as const;
  const [panchagavyaVideoIndex, setPanchagavyaVideoIndex] = useState(0);
  const panchagavyaVideoSources = ["/assets/panchagabyavideo.mp4", "/assets/dhanlaxmi.mp4"] as const;

  useEffect(() => {
    const audio = mantraAudioRef.current;
    if (!audio) return;

    audio.src = "/assets/sri-surabhyai-namah.mp3";
    audio.load();
    audio.volume = 0.25;
    audio.loop = true;
    audio.muted = false;

    void audio.play().then(() => {
      setAudioEnabled(true);
    }).catch(() => {
      setAudioEnabled(false);
    });
  }, []);

  const handleMantraToggle = async () => {
    const audio = mantraAudioRef.current;
    if (!audio) return;
    if (audioEnabled) {
      audio.pause();
      audio.muted = false;
      setAudioEnabled(false);
      return;
    }
    try {
      audio.volume = 0.25;
      audio.loop = true;
      audio.muted = false;
      await audio.play();
      setAudioEnabled(true);
    } catch (error) {
      console.warn("Unable to play mantra audio on demand:", error);
      audio.pause();
      setAudioEnabled(false);
    }
  };
  const publicUrl = getCampaignPublicUrl(organization, campaign);
  const incomingReferralCode = useMemo(() => {
    if (typeof window === "undefined") return "";
    const referralValues = new URLSearchParams(window.location.search).getAll("ref");
    if (referralValues.length !== 1) return "";
    const normalized = normalizeReferralCode(referralValues[0]);
    return /^VU-[A-Z0-9]{6,64}$/.test(normalized) ? normalized : "";
  }, [campaign.id]);
  const personalReferralCode =
    lastSignedSigner?.campaignId === campaign.id ? getPersistedSupporterReferralCode(lastSignedSigner) : "";
  const personalReferralUrl = personalReferralCode
    ? getCampaignReferralUrl(organization, campaign, personalReferralCode)
    : publicUrl;
  const configuredShareMessages = getConfiguredGrowthShareMessages({
    campaign: displayCampaign,
    organization,
    signer: lastSignedSigner,
    referralLink: personalReferralUrl,
    campaignProgress: metrics.progress,
    supporterCount: metrics.total,
    verifiedSupporters: metrics.verified
  });
  const shareMessages = isGoudhanExperience
    ? {
        ...configuredShareMessages,
        whatsapp: `${displayCampaign.socialShareText}\n${personalReferralUrl}`,
        emailSubject: displayCampaign.title,
        emailBody: `${displayCampaign.socialShareText}\n${personalReferralUrl}`,
        social: displayCampaign.socialShareText,
        instagramCaption: displayCampaign.socialShareText
      }
    : configuredShareMessages;
  const [copiedReferral, setCopiedReferral] = useState("");
  const [wizardStep, setWizardStep] = useState<SigningStepId>(
    publicForm.otpVerified ||
    (publicForm.verificationMethod === "screen_otp" && Boolean(publicForm.otpVerificationToken))
      ? "profile"
      : "phone"
  );
  const [supporterSession, setSupporterSession] = useState<CampaignSupporterSession | null>(null);
  const [supporterSessionChecking, setSupporterSessionChecking] = useState(true);
  const [supporterAccessError, setSupporterAccessError] = useState(false);
  const [supporterSessionRevision, setSupporterSessionRevision] = useState(0);
  const [supporterSignOutBusy, setSupporterSignOutBusy] = useState(false);
  const [authPopoverOpen, setAuthPopoverOpen] = useState(false);
  const [accountMenuOpen, setAccountMenuOpen] = useState(false);
  const signInTriggerRef = useRef<HTMLButtonElement>(null);
  const authPopoverRef = useRef<HTMLDivElement>(null);
  const accountMenuTriggerRef = useRef<HTMLButtonElement>(null);
  const accountMenuRef = useRef<HTMLDivElement>(null);
  useEffect(() => {
    try {
      const { data } = getSupporterAuthClient().auth.onAuthStateChange((event) => {
        if (!["SIGNED_IN", "SIGNED_OUT", "USER_UPDATED"].includes(event)) return;
        setSupporterSession(null);
        setSupporterAccessError(false);
        setSupporterSessionChecking(true);
        setAccountMenuOpen(false);
        setSupporterSessionRevision((value) => value + 1);
      });
      return () => data.subscription.unsubscribe();
    } catch {
      return undefined;
    }
  }, []);
  useEffect(() => {
    let alive = true;
    setSupporterSessionChecking(true);
    setSupporterSession(null);
    setSupporterAccessError(false);
    void (async () => {
      try {
        const identity = await getCurrentSupporterIdentity();
        if (!identity) {
          if (alive) setSupporterSession(null);
          return;
        }
        // Authentication alone is never campaign ownership. Resolve the server-owned
        // manifest first, then read the exact owned dashboard before hiding signing.
        const manifest = await loadVoiceupAccessManifest();
        const ownership = manifest.supporterOwnerships.find((item) =>
          item.campaignId === campaign.id &&
          (!item.campaignSlug || item.campaignSlug.trim().toLowerCase() === campaign.slug.trim().toLowerCase())
        );
        const destination = resolveCampaignSupporterDestination(manifest, {
          campaignId: campaign.id,
          campaignSlug: campaign.slug
        });
        let dashboard: SupporterDashboardModel | null = null;
        if (ownership && destination) {
          const candidate = await loadOwnedSupporterDashboard(ownership.accountId);
          if (
            candidate.account.campaignId === campaign.id &&
            candidate.account.supporterId === ownership.supporterId &&
            candidate.campaign.slug.trim().toLowerCase() === campaign.slug.trim().toLowerCase() &&
            candidate.supporter.status === "verified"
          ) {
            dashboard = candidate;
          }
        }
        if (alive) {
          setSupporterSession({
            name: dashboard?.supporter.name.trim() || ownership?.supporterName.trim() || "Supporter",
            email: identity.email,
            dashboardPath: dashboard && destination ? destination.path : "",
            dashboard,
            approvedVolunteer: Boolean(dashboard && ownership && manifest.volunteerAssignments.some((item) =>
              item.accountId === ownership.accountId &&
              item.campaignId === campaign.id &&
              item.supporterId === ownership.supporterId &&
              (item.status === "approved" || item.status === "assigned")
            )),
            authorizedCoordinator: Boolean(dashboard && manifest.coordinatorBindings.some((item) =>
              item.workspaceId === dashboard?.account.workspaceId &&
              item.campaignIds.includes(campaign.id) &&
              item.status === "active" &&
              item.canOpenBusinessOs
            ))
          });
        }
      } catch {
        if (alive) {
          setSupporterSession(null);
          setSupporterAccessError(true);
        }
      } finally {
        if (alive) setSupporterSessionChecking(false);
      }
    })();
    return () => { alive = false; };
  }, [campaign.id, campaign.slug, supporterSessionRevision]);
  const ownedCampaignSignature = supporterSession?.dashboard?.supporter.status === "verified";
  const supporterReferralCode = normalizeReferralCode(
    supporterSession?.dashboard?.supporter.referralCode ?? ""
  );
  const supporterReferralUrl = supporterReferralCode && /^VU-[A-Z0-9]{6,64}$/.test(supporterReferralCode)
    ? getCampaignReferralUrl(organization, campaign, supporterReferralCode)
    : "";
  async function signOutFromCampaign() {
    if (supporterSignOutBusy) return;
    setSupporterSignOutBusy(true);
    try {
      await logoutSupporter();
      setSupporterSession(null);
      setSupporterAccessError(false);
      setAuthPopoverOpen(false);
      setAccountMenuOpen(false);
      setParticipationMode("support");
      setSupporterSessionRevision((value) => value + 1);
    } catch {
      // Do not claim logout succeeded when the auth provider reports failure.
    } finally {
      setSupporterSignOutBusy(false);
    }
  }
  const supporterHeaderCopy = language === "hi"
    ? { welcome: "इस रूप में साइन इन", dashboard: "मेरा डैशबोर्ड", certificates: "मेरे प्रमाणपत्र", home: "होम", signOut: "साइन आउट", account: "समर्थक खाता" }
    : language === "or"
      ? { welcome: "ଏହି ନାମରେ ସାଇନ୍ ଇନ୍", dashboard: "ମୋ ଡ୍ୟାସବୋର୍ଡ", certificates: "ମୋ ପ୍ରମାଣପତ୍ର", home: "ହୋମ୍", signOut: "ସାଇନ୍ ଆଉଟ୍", account: "ସମର୍ଥକ ଖାତା" }
      : { welcome: "Signed in as", dashboard: "My Dashboard", certificates: "My Certificates", home: "Home", signOut: "Sign Out", account: "Supporter account" };
  const [participationMode, setParticipationMode] = useState<"support" | "sign_in">(() =>
    typeof window !== "undefined" && window.location.hash === "#campaign-sign-in"
      ? "sign_in"
      : "support"
  );
  useEffect(() => {
    const panel = authPopoverOpen ? authPopoverRef.current : accountMenuOpen ? accountMenuRef.current : null;
    const trigger = authPopoverOpen ? signInTriggerRef.current : accountMenuTriggerRef.current;
    if (!panel) return;
    const focusableSelector = "button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex='-1'])";
    const frame = window.requestAnimationFrame(() => {
      panel.querySelector<HTMLElement>(focusableSelector)?.focus();
    });
    function closeAndRestoreFocus() {
      setAuthPopoverOpen(false);
      setAccountMenuOpen(false);
      window.requestAnimationFrame(() => trigger?.focus());
    }
    function handleKeyDown(event: KeyboardEvent) {
      if (event.key === "Escape") {
        event.preventDefault();
        closeAndRestoreFocus();
        return;
      }
      if (event.key !== "Tab" || !panel) return;
      const focusable = Array.from(panel.querySelectorAll<HTMLElement>(focusableSelector));
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
    function handlePointerDown(event: PointerEvent) {
      const target = event.target as Node;
      if (!panel?.contains(target) && !trigger?.contains(target)) closeAndRestoreFocus();
    }
    document.addEventListener("keydown", handleKeyDown);
    document.addEventListener("pointerdown", handlePointerDown);
    return () => {
      window.cancelAnimationFrame(frame);
      document.removeEventListener("keydown", handleKeyDown);
      document.removeEventListener("pointerdown", handlePointerDown);
    };
  }, [accountMenuOpen, authPopoverOpen]);

  useEffect(() => {
    if (!supporterSessionChecking && supporterSession) setAuthPopoverOpen(false);
  }, [supporterSession, supporterSessionChecking]);
  const [supporterRoutingPrecheck, setSupporterRoutingPrecheck] =
    useState<PublicSupporterRoutingPrecheck | null>(() => readSupporterRoutingPrecheck(campaign.id));
  const [supporterRoutingChecking, setSupporterRoutingChecking] = useState(false);
  const [supporterRoutingError, setSupporterRoutingError] = useState(false);
  const [supporterRoutingAttempt, setSupporterRoutingAttempt] = useState(0);
  const [verificationOutcome, setVerificationOutcome] =
    useState<PublicSigningVerificationOutcome | null>(null);
  // A server-confirmed duplicate is a returning-supporter journey, not a
  // reason to repeat the six-step signing form. Authentication remains required.
  useEffect(() => {
    if (publicMessage !== "existing_supporter_duplicate") return;
    setVerificationOutcome("secure_access_required");
    setAuthPopoverOpen(true);
  }, [publicMessage]);
  const [returningSupporterDetected, setReturningSupporterDetected] = useState(false);
  const [retryingSupporterLookup, setRetryingSupporterLookup] = useState(false);
  const [restoredDraftStorageKey, setRestoredDraftStorageKey] = useState("");
  const [sendingOtp, setSendingOtp] = useState(false);
  const [verifyingOtp, setVerifyingOtp] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [postSignPanel, setPostSignPanel] = useState<InvolvementPanel>("none");
  const [coordinatorLearnMore, setCoordinatorLearnMore] = useState(false);
  const [communicationConsent, setCommunicationConsent] = useState(false);
  const [appealConsent, setAppealConsent] = useState(false);
  const [campaignConsent, setCampaignConsent] = useState(false);
  const [photoPanelDismissed, setPhotoPanelDismissed] = useState(false);
  const [volunteerSkills, setVolunteerSkills] = useState("");
  const [volunteerInterests, setVolunteerInterests] = useState("");
  const [volunteerAvailability, setVolunteerAvailability] = useState("");
  const [volunteerWorkingArea, setVolunteerWorkingArea] = useState("");
  const [volunteerConsent, setVolunteerConsent] = useState(false);
  const [coordinatorLevel, setCoordinatorLevel] =
    useState<ParticipationRequestLevel>("ward");
  const [coordinatorMinimumLevel, setCoordinatorMinimumLevel] =
    useState<ParticipationRequestLevel | "">("");
  const [coordinatorLocation, setCoordinatorLocation] = useState<LocationWithPin>({
    country: "India",
    state: "",
    district: "",
    block: "",
    panchayat: "",
    postalCode: ""
  });
  const [coordinatorLocationReference, setCoordinatorLocationReference] =
    useState<PersistedLocationReference | null>(null);
  const [coordinatorWard, setCoordinatorWard] = useState("");
  const [coordinatorExperience, setCoordinatorExperience] = useState("");
  const [coordinatorMotivation, setCoordinatorMotivation] = useState("");
  const [coordinatorAvailability, setCoordinatorAvailability] = useState("");
  const [coordinatorConsent, setCoordinatorConsent] = useState(false);
  const [submittingMovementRequest, setSubmittingMovementRequest] = useState(false);
  const [savedMovementRequests, setSavedMovementRequests] =
    useState<PublicParticipationRequest[]>([]);
  const [showMovementDashboard, setShowMovementDashboard] = useState(false);
  const [movementRequestError, setMovementRequestError] = useState("");
  const movementRequestAttemptRef = useRef<{
    fingerprint: string;
    idempotencyKey: string;
  } | null>(null);
  const stepHeadingRef = useRef<HTMLHeadingElement>(null);
  const publicMessageRef = useRef<HTMLParagraphElement>(null);
  const movementRequestResultRef = useRef<HTMLHeadingElement>(null);
  const previousWizardStepRef = useRef<SigningStepId>(wizardStep);
  const hasSignedCampaign = lastSignedSigner?.campaignId === campaign.id;
  const publicVerificationComplete = Boolean(
    publicForm.otpVerificationToken &&
    (publicForm.otpVerified || publicForm.verificationMethod === "screen_otp")
  );
  const campaignGoal = getCampaignGoalValue(campaign);
  const configuredCampaignGoal =
    Number.isFinite(campaign.goal) && campaign.goal > 0 ? campaign.goal : null;
  const signingCampaignScope = useMemo(
    () => ({ campaignId: campaign.id, slug: campaign.slug }),
    [campaign.id, campaign.slug]
  );
  const draftStorageKey = getPublicSigningJourneyStorageKey(signingCampaignScope);
  const isRequired = (field: SignerRequiredField) => requiredFields.includes(field);
  const emailRequired = isRequired("email") || isGoudhanExperience;
  const locationRequired = requiredFields.some((field) =>
    ["country", "state", "district", "block", "panchayat", "postalCode"].includes(field)
  );
  const detailsRequired = Boolean(restrictionMessage || locationRequired || isRequired("address"));
  const hasOptionalDetails = Boolean(
    publicForm.country ||
      publicForm.state ||
      publicForm.district ||
      publicForm.block ||
      publicForm.panchayat ||
      publicForm.postalCode ||
      publicForm.address ||
      publicForm.whatsappNumber ||
      publicForm.telegramHandle ||
      publicForm.referredByPhoneOrCode
  );
  const activeSigningSteps = signingSteps.filter(
    (step) => step.id !== "address" || detailsRequired || hasOptionalDetails || wizardStep === "address"
  );
  const activeStepIndex = Math.max(0, activeSigningSteps.findIndex((step) => step.id === wizardStep));
  const indianMobile = normalizeIndianMobileInput(publicForm.phone);
  const phoneDigits = publicForm.phone.replace(/\D/g, "");
  const phoneNumberReady =
    premiumPresentation
      ? indianMobile.valid
      : /^[0-9+()\s-]+$/.test(publicForm.phone.trim()) &&
        phoneDigits.length >= 8 &&
        phoneDigits.length <= 15;
  const phoneReady = phoneNumberReady;
  const showPhoneError = premiumPresentation
    ? indianMobile.complete && !indianMobile.valid
    : Boolean(publicForm.phone.trim()) && !phoneNumberReady;
  const otpReady = /^\d{6}$/.test(otpInput.trim());
  const emailReady = publicForm.email.trim()
    ? isValidPublicSignerEmail(publicForm.email)
    : !emailRequired;
  const profileReady =
    (!isRequired("name") || Boolean(publicForm.name.trim())) && emailReady;
  const detailsReady = requiredFields
    .filter((field) =>
      ["country", "state", "district", "block", "panchayat", "postalCode", "address"].includes(field)
    )
    .every((field) => Boolean(restrictedPublicForm[field]?.trim()));
  const requiredConsentsAccepted = appealConsent && campaignConsent;

  useEffect(() => {
    if (wizardStep !== "phone") {
      setSupporterRoutingChecking(false);
      setSupporterRoutingError(false);
      return;
    }
    if (!phoneReady) {
      clearSupporterRoutingPrecheck(campaign.id);
      setSupporterRoutingPrecheck(null);
      setSupporterRoutingChecking(false);
      setSupporterRoutingError(false);
      return;
    }
    clearSupporterRoutingPrecheck(campaign.id);
    setSupporterRoutingPrecheck(null);
    setSupporterRoutingChecking(true);
    setSupporterRoutingError(false);
    let active = true;
    const timer = window.setTimeout(() => {
      void precheckPublicSupporterRouting(campaign.slug, publicForm.phone)
        .then((precheck) => {
          if (!active) return;
          writeSupporterRoutingPrecheck(campaign.id, precheck);
          setSupporterRoutingPrecheck(precheck);
        })
        .catch(() => {
          if (!active) return;
          // Preserve the entered number and require an explicit retry instead
          // of bypassing the server-side routing check.
          clearSupporterRoutingPrecheck(campaign.id);
          setSupporterRoutingPrecheck(null);
          setSupporterRoutingError(true);
        })
        .finally(() => {
          if (active) setSupporterRoutingChecking(false);
        });
    }, 450);
    return () => {
      active = false;
      window.clearTimeout(timer);
    };
  }, [campaign.id, campaign.slug, phoneReady, publicForm.phone, supporterRoutingAttempt, wizardStep]);
  const currentStepLabel =
    wizardStep === "review" ? t("public.review") : copy.steps[wizardStep];
  const stepProgressLabel = t("public.stepProgress")
    .replace("{current}", String(activeStepIndex + 1))
    .replace("{total}", String(activeSigningSteps.length))
    .replace("{step}", currentStepLabel);
  const heroSummary =
    displayCampaign.description.trim() ||
    t("public.defaultCampaignSummary").replace("{campaign}", displayCampaign.title);
  const signedAtValues = campaignSigners
    .map((signer) => signer.signedAt?.trim())
    .filter((value): value is string => Boolean(value))
    .sort();
  const latestSignatureAt = signedAtValues.length > 0 ? signedAtValues[signedAtValues.length - 1] : undefined;
  const localizedGoudhanUpdate = renderCampaignMessage(t("goudhanCampaign.latestUpdate"),
    { ...displayCampaign, shareUrl: publicUrl },
    metrics
  );
  const campaignUpdates = campaign.participantUpdateMessage.trim()
    ? [
        isGoudhanExperience
          ? localizedGoudhanUpdate
          : renderCampaignMessage(
              campaign.participantUpdateMessage,
              { ...displayCampaign, shareUrl: publicUrl },
              metrics
            )
      ]
    : [];
  const youtubeEmbedUrl = getYouTubeEmbedUrl(campaign.campaignVideoUrl);
  const configuredCampaignMedia = Boolean(displayCampaign.heroImage || campaign.campaignVideoUrl.trim());
  const hasCampaignMedia = premiumPresentation
    ? Boolean(campaignSupportingArtwork || campaign.campaignVideoUrl.trim())
    : configuredCampaignMedia;
  const premiumVisibleMetrics = premiumPresentation && presentationCopy
    ? getVisiblePublicMetrics([
        { key: "online", label: presentationCopy.statOnline, value: metrics.online },
        { key: "verified", label: presentationCopy.statVerified, value: metrics.verified },
        {
          key: "paper",
          label: presentationCopy.statHardcopy,
          value: metrics.scanned
        },
        {
          key: "goal",
          label: t("campaignAdmin.fields.targetSignatures"),
          value: configuredCampaignGoal
        },
        {
          key: "total",
          label: presentationCopy.statTotal,
          value: metrics.total
        }
      ])
    : [];
  const authorityCards = (
    showNeutralAuthority
      ? []
      : campaign.authoritySelectionMode === "public_choice" && publicAuthorityOptions.length > 0
        ? publicAuthorityOptions
        : [resolvedAuthority]
  ).slice(0, 3);
  const storyCards = [
    {
      icon: <HeartHandshake size={20} />,
      title: t("public.story.publicAsk"),
      body: displayCampaign.appealContent || displayCampaign.description
    },
    ...(showNeutralAuthority
      ? []
      : [{
          icon: <Landmark size={20} />,
          title: t("public.story.recipient"),
          body: formatAuthorityDisplay(resolvedAuthority)
        }]),
    {
      icon: <CalendarDays size={20} />,
      title: t("public.story.window"),
      body: [campaign.startDate, campaign.endDate].filter(Boolean).join(` ${t("public.to")} `)
    }
  ].filter((item) => item.body.trim());
  const movementMatterCards = (
    presentationCopy
      ? [
          {
            icon: <HeartHandshake size={20} />,
            title: presentationCopy.pillars[0],
            body: displayCampaign.description
          },
          {
            icon: <ShieldCheck size={20} />,
            title: presentationCopy.pillars[1],
            body: displayCampaign.appealContent
          },
          {
            icon: <Users size={20} />,
            title: presentationCopy.pillars[2],
            body: displayCampaign.socialShareText || displayCampaign.appealContent
          }
        ]
      : [
          {
            icon: <ClipboardList size={20} />,
            title: t("public.movement.problem"),
            body: displayCampaign.description
          },
          {
            icon: <HeartHandshake size={20} />,
            title: t("public.movement.whyItMatters"),
            body: displayCampaign.appealContent
          },
          {
            icon: <Landmark size={20} />,
            title: t("public.movement.desiredChange"),
            body: displayCampaign.appealContent
          },
          {
            icon: <Users size={20} />,
            title: t("public.movement.supporterHelp"),
            body: displayCampaign.socialShareText || displayCampaign.appealContent
          }
        ]
  ).filter((item) => item.body.trim());
  const movementTrustItems = [
    campaign.status === "Published"
      ? {
          icon: <CheckCircle2 size={20} />,
          label: t("public.movement.campaignStatus"),
          value: t("campaignAdmin.status.published"),
          href: undefined
        }
      : null,
    organization?.name.trim()
      ? {
          icon: <Users size={20} />,
          label: t("public.movement.organiser"),
          value: organization.name.trim(),
          href: undefined
        }
      : null,
    campaignConfiguredAuthority
      ? {
          icon: <Landmark size={20} />,
          label: t("public.movement.receivingAuthority"),
          value: formatAuthorityDisplay(campaignConfiguredAuthority),
          href: undefined
        }
      : null,
    displayCampaign.consentText.trim()
      ? {
          icon: <ShieldCheck size={20} />,
          label: t("public.movement.transparency"),
          value: displayCampaign.consentText.trim(),
          href: undefined
        }
      : null,
    campaign.adminEmail.trim()
      ? {
          icon: <Mail size={20} />,
          label: t("public.movement.campaignContact"),
          value: campaign.adminEmail.trim(),
          href: `mailto:${campaign.adminEmail.trim()}`
        }
      : null
  ].filter((item): item is NonNullable<typeof item> => Boolean(item));
  const movementFaqItems = [
    {
      question: t("public.movement.faqWhyJoin"),
      answer: displayCampaign.description
    },
    {
      question: t("public.movement.faqInformation"),
      answer: displayCampaign.consentText
    },
    {
      question: t("public.movement.faqVolunteer"),
      answer: t("public.movement.faqVolunteerAnswer")
    },
    {
      question: t("public.movement.faqSubmission"),
      answer: campaignConfiguredAuthority
        ? t("public.movement.faqSubmissionConfigured").replace(
            "{authority}",
            formatAuthorityDisplay(campaignConfiguredAuthority)
          )
        : t("public.movement.faqSubmissionPending")
    },
    ...(organization?.name.trim()
      ? [{
          question: t("public.movement.faqOrganising"),
          answer: t("public.movement.faqOrganisingAnswer").replace(
            "{organiser}",
            organization.name.trim()
          )
        }]
      : [])
  ].filter((item) => item.answer.trim());
  const minimumCoordinatorLevels = getMinimumParticipationLevels(coordinatorLevel);
  const coordinatorRequiredFields: SignerRequiredField[] =
    coordinatorLevel === "national"
      ? []
      : coordinatorLevel === "state"
        ? ["state"]
        : coordinatorLevel === "district"
          ? ["state", "district"]
          : coordinatorLevel === "block"
            ? ["state", "district", "block"]
            : ["state", "district", "block", "panchayat"];
  const coordinatorLocationReady =
    coordinatorRequiredFields.every((field) =>
      Boolean(coordinatorLocation[field as keyof LocationWithPin]?.trim())
    )
    && (coordinatorLevel !== "ward" || Boolean(coordinatorWard.trim()));
  const requestConsentVersion = createConsentVersion(isGoudhanExperience ? displayCampaign.consentText : campaign.consentText);
  const savedMovementRequest = savedMovementRequests[0] ?? null;
  const requestDateLocale =
    language === "hi" ? "hi-IN" : language === "or" ? "or-IN" : "en-IN";
  const shareText = `${shareMessages.social}\n${personalReferralUrl}`;
  const whatsappText = shareMessages.whatsapp.includes(personalReferralUrl)
    ? shareMessages.whatsapp
    : `${shareMessages.whatsapp || shareMessages.social}\n${personalReferralUrl}`;
  const shareLinks = {
    whatsapp: `https://wa.me/?text=${encodeURIComponent(whatsappText || shareText)}`,
    telegram: `https://t.me/share/url?url=${encodeURIComponent(personalReferralUrl)}&text=${encodeURIComponent(shareMessages.social)}`,
    facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(personalReferralUrl)}`,
    x: `https://twitter.com/intent/tweet?url=${encodeURIComponent(personalReferralUrl)}&text=${encodeURIComponent(shareMessages.social)}`,
    email: `mailto:?subject=${encodeURIComponent(shareMessages.emailSubject)}&body=${encodeURIComponent(shareMessages.emailBody)}`
  };
  const nativeShareSupported =
    typeof navigator !== "undefined" && typeof navigator.share === "function";
  const locationFields = isGoudhanExperience ? (
    <IndiaLocationFields
      idPrefix="public-signer-location"
      values={{ ...publicLocationForm, address: publicForm.address, country: "India" }}
      onChange={(values) => setPublicForm((current) =>
        applySignerLocationRestriction(
          campaign,
          {
            ...current,
            ...values,
            address: values.address ?? current.address,
            country: "India",
            locationReference: createUnverifiedLocationReference(
              { ...values, country: "India" },
              "public_signer_manual"
            )
          },
          organization
        )
      )}
      locationOverrides={locationOverrides}
      locationDeletions={locationDeletions}
      allowedLocation={publicIndiaAllowedLocation}
      hiddenLockedLevel={signerRestrictionLevel}
      requiredFields={requiredFields}
      labelOverrides={copy.locationLabels}
      fixedCountry="India"
      customLocations={signerLocationCatalog}
      catalogStatus={publicCampaignLocationCatalog.status}
      onPinObservation={(values, postalCode) => setPublicForm((current) => ({
        ...current,
        ...values,
        locationReference: createObservedLocationReference(
          values,
          "public_signer_pin",
          [{ kind: "pin", valueSnapshot: postalCode }]
        )
      }))}
    />
  ) : isGlobalMode ? (
    <GlobalLocationFields
      idPrefix="public-signer-location"
      values={publicLocationForm}
      onChange={(values) => setPublicForm((current) =>
        applySignerLocationRestriction(campaign, {
          ...current,
          ...values,
          locationReference: createUnverifiedLocationReference(values, "public_signer_global_manual")
        }, organization)
      )}
      allowedLocation={lockedLocation}
      hiddenLockedLevel={signerRestrictionLevel}
      requiredFields={requiredFields}
      labelOverrides={copy.locationLabels}
    />
  ) : (
    <IndiaLocationFields
      idPrefix="public-signer-location"
      values={{ ...restrictedPublicForm, address: publicForm.address }}
      onChange={(values) => setPublicForm((current) =>
        applySignerLocationRestriction(campaign, {
          ...current,
          ...values,
          address: values.address ?? current.address,
          locationReference: createUnverifiedLocationReference(values, "public_signer_manual")
        }, organization)
      )}
      locationOverrides={locationOverrides}
      locationDeletions={locationDeletions}
      allowedLocation={publicIndiaAllowedLocation}
      hiddenLockedLevel={signerRestrictionLevel}
      requiredFields={requiredFields}
      labelOverrides={copy.locationLabels}
      customLocations={signerLocationCatalog}
      catalogStatus={publicCampaignLocationCatalog.status}
      onPinObservation={(values, postalCode) => setPublicForm((current) => ({
        ...current,
        ...values,
        locationReference: createObservedLocationReference(
          values,
          "public_signer_pin",
          [{ kind: "pin", valueSnapshot: postalCode }]
        )
      }))}
    />
  );

  useEffect(() => {
    if (!incomingReferralCode) return;
    setPublicForm((current) =>
      current.referredByPhoneOrCode === incomingReferralCode && current.referralSource === "url"
        ? current
        : { ...current, referredBy: "", referredByPhoneOrCode: incomingReferralCode, referralSource: "url" }
    );
  }, [
    incomingReferralCode,
    publicForm.referredByPhoneOrCode,
    publicForm.referralSource,
    setPublicForm
  ]);

  useEffect(() => {
    if (typeof window === "undefined" || restoredDraftStorageKey === draftStorageKey) return;
    const saved = readPublicSigningDraft(window.sessionStorage, signingCampaignScope);
    if (saved?.form) {
      setPublicForm((current) =>
        clearPublicSigningOtpState({
          ...current,
          ...saved.form,
          ...(incomingReferralCode
            ? { referredBy: "", referredByPhoneOrCode: incomingReferralCode, referralSource: "url" as const }
            : {})
        })
      );
    }
    setWizardStep("phone");
    setCommunicationConsent(false);
    setAppealConsent(false);
    setCampaignConsent(false);
    setRestoredDraftStorageKey(draftStorageKey);
  }, [draftStorageKey, incomingReferralCode, restoredDraftStorageKey, setPublicForm, signingCampaignScope]);

  useEffect(() => {
    if (restoredDraftStorageKey !== draftStorageKey || typeof window === "undefined") return;
    if (hasSignedCampaign) {
      clearPublicSigningJourney(window.sessionStorage, signingCampaignScope);
      return;
    }
    writePublicSigningDraft(window.sessionStorage, signingCampaignScope, publicForm);
  }, [draftStorageKey, restoredDraftStorageKey, hasSignedCampaign, publicForm, signingCampaignScope]);

  useEffect(() => {
    if (!onSaveDraft || !publicForm.otpVerified || !publicForm.otpVerificationToken || hasSignedCampaign) return;
    const timer = window.setTimeout(() => {
      void onSaveDraft();
    }, 700);
    return () => window.clearTimeout(timer);
  }, [
    hasSignedCampaign,
    onSaveDraft,
    publicForm,
    publicForm.otpVerificationToken,
    publicForm.otpVerified
  ]);

  useEffect(() => {
    if (hasSignedCampaign && wizardStep !== "done") {
      setCommunicationConsent(false);
      setAppealConsent(false);
      setCampaignConsent(false);
      setWizardStep("done");
    }
  }, [hasSignedCampaign, wizardStep]);

  useEffect(() => {
    if (previousWizardStepRef.current === wizardStep) return;
    previousWizardStepRef.current = wizardStep;
    const frame = window.requestAnimationFrame(() => stepHeadingRef.current?.focus());
    return () => window.cancelAnimationFrame(frame);
  }, [wizardStep]);

  useEffect(() => {
    if (!publicMessageIsError || !displayPublicMessage) return;
    const frame = window.requestAnimationFrame(() => publicMessageRef.current?.focus());
    return () => window.cancelAnimationFrame(frame);
  }, [displayPublicMessage, publicMessageIsError]);

  useEffect(() => {
    if (!hasSignedCampaign || !lastSignedSigner) return;
    setCoordinatorLocation((current) => {
      if (current.state || current.district || current.block || current.panchayat) return current;
      return {
        country: lastSignedSigner.country || "India",
        state: lastSignedSigner.state || "",
        district: lastSignedSigner.district || "",
        block: lastSignedSigner.block || "",
        panchayat: lastSignedSigner.panchayat || "",
        postalCode: lastSignedSigner.postalCode || ""
      };
    });
    setCoordinatorWard((current) => current || lastSignedSigner.address || "");
  }, [hasSignedCampaign, lastSignedSigner]);

  useEffect(() => {
    if (!movementRequests) return;
    setSavedMovementRequests(movementRequests);
  }, [movementRequests]);

  async function persistMovementRequest(request: ParticipationRequestSubmission) {
    if (!onSubmitMovementRequest || submittingMovementRequest) return;
    const fingerprint = participationRequestFingerprint(request);
    if (movementRequestAttemptRef.current?.fingerprint !== fingerprint) {
      movementRequestAttemptRef.current = {
        fingerprint,
        idempotencyKey: createParticipationRequestIdempotencyKey()
      };
    }
    setSubmittingMovementRequest(true);
    setMovementRequestError("");
    try {
      const saved = await onSubmitMovementRequest(
        request,
        movementRequestAttemptRef.current.idempotencyKey
      );
      setSavedMovementRequests((current) => [
        saved,
        ...current.filter((item) => item.id !== saved.id && item.requestType !== saved.requestType)
      ]);
      movementRequestAttemptRef.current = null;
      window.requestAnimationFrame(() => movementRequestResultRef.current?.focus());
    } catch (error) {
      const code = participationRequestErrorCode(error);
      setMovementRequestError(
        code
          ? `${t(`public.requests.error.${code}`)} (${code})`
          : t("public.requests.retry")
      );
    } finally {
      setSubmittingMovementRequest(false);
    }
  }

  async function submitVolunteerMovementRequest() {
    if (!volunteerConsent) return;
    await persistMovementRequest({
      requestType: "volunteer",
      requestedRole: "volunteer",
      geographicScope: {
        country: lastSignedSigner?.country || "India",
        state: lastSignedSigner?.state || "",
        district: lastSignedSigner?.district || "",
        block: lastSignedSigner?.block || "",
        panchayat: lastSignedSigner?.panchayat || "",
        locationReference: lastSignedSigner?.locationReference ?? null
      },
      skills: parseParticipationRequestList(volunteerSkills),
      areasOfInterest: parseParticipationRequestList(volunteerInterests),
      availability: volunteerAvailability.trim(),
      preferredWorkingArea: volunteerWorkingArea.trim(),
      consent: {
        granted: true,
        version: requestConsentVersion,
        policyId: requestConsentVersion
      }
    });
  }

  async function submitCoordinatorMovementRequest() {
    if (!coordinatorConsent || !coordinatorLocationReady) return;
    await persistMovementRequest({
      requestType: "coordinator",
      requestedRole: "coordinator",
      preferredLevel: coordinatorLevel,
      minimumAcceptableLevel: coordinatorMinimumLevel || undefined,
      geographicScope: {
        country: coordinatorLocation.country || "India",
        state: coordinatorLocation.state,
        district: coordinatorLocation.district,
        block: coordinatorLocation.block,
        panchayat: coordinatorLocation.panchayat,
        ward: coordinatorWard.trim(),
        locationReference: coordinatorLocationReference
      },
      motivation: coordinatorMotivation.trim(),
      experience: coordinatorExperience.trim(),
      availability: coordinatorAvailability.trim(),
      consent: {
        granted: true,
        version: requestConsentVersion,
        policyId: requestConsentVersion
      }
    });
  }

  async function handleSendOtpWizard() {
    if (sendingOtp || supporterRoutingChecking || supporterRoutingError || !phoneReady) return;
    setSendingOtp(true);
    try {
      const sent = await onSendOtp();
      if (sent === false) return;
      setWizardStep("otp");
    } finally {
      setSendingOtp(false);
    }
  }

  async function handleVerifyOtpWizard() {
    if (verifyingOtp) return;
    setVerifyingOtp(true);
    try {
      const outcome = await onVerifyOtp();
      // Anonymous precheck never discloses whether a phone has an account.
      // Screen OTP authorizes a signing attempt, not account ownership.
      // The server rejects duplicate supporters during atomic submission.
      applyVerificationOutcome(outcome);
    } finally {
      setVerifyingOtp(false);
    }
  }

  function applyVerificationOutcome(outcome: PublicSigningVerificationOutcome) {
    if (outcome === "stale") return;
    setVerificationOutcome(outcome);
    if (outcome === "returning_supporter") {
      setReturningSupporterDetected(true);
      setWizardStep("done");
      return;
    }
    if (outcome === "new_supporter") {
      setReturningSupporterDetected(false);
      setWizardStep("profile");
      return;
    }
    if (outcome === "secure_access_required") {
      setAuthPopoverOpen(true);
    }
  }

  async function handleRetrySupporterLookup() {
    if (retryingSupporterLookup) return;
    setRetryingSupporterLookup(true);
    try {
      applyVerificationOutcome(await onRetryVerifiedSupporterLookup());
    } finally {
      setRetryingSupporterLookup(false);
    }
  }

  async function handlePublicSubmit(event: FormEvent) {
    if (wizardStep !== "review") {
      event.preventDefault();
      return;
    }
    if (submitting) {
      event.preventDefault();
      return;
    }
    setSubmitting(true);
    try {
      await onSubmit(event);
    } finally {
      setSubmitting(false);
    }
  }

  function handleStartNewJourney() {
    setCommunicationConsent(false);
    setAppealConsent(false);
    setCampaignConsent(false);
    clearSupporterRoutingPrecheck(campaign.id);
    setSupporterRoutingPrecheck(null);
    setVerificationOutcome(null);
    setReturningSupporterDetected(false);
    setRetryingSupporterLookup(false);
    onStartNewJourney();
  }

  async function copyReferralText(
    label: string,
    value: string,
    channel: GrowthShareContext["channel"] = "copy"
  ) {
    try {
      await navigator.clipboard.writeText(value);
      setCopiedReferral(t("public.copied"));
      onGrowthShare?.({ channel, url: value });
    } catch {
      setCopiedReferral(t("public.copyFailed"));
    }
  }

  function trackShareClick(channel: GrowthShareContext["channel"]) {
    onGrowthShare?.({ channel, url: personalReferralUrl });
  }

  function downloadActQr() {
    trackShareClick("qr");
    downloadQrPosterSvg({
      campaign: displayCampaign,
      organizationName: publicOrganizationLabel || "VoiceUp",
      url: personalReferralUrl,
      referralCode: personalReferralCode
    });
  }

  async function shareNatively() {
    if (!navigator.share) return;
    try {
      await navigator.share({
        title: displayCampaign.title,
        text: shareMessages.social,
        url: personalReferralUrl
      });
      trackShareClick("native");
    } catch {
      // Cancellation and browser share failures are intentionally not recorded.
    }
  }

  const accountToolbar = (
      <div className="public-page-language-toolbar" aria-label="Language selector">
        {supporterSession ? (
          <div className="gsaa-account-menu-anchor">
            <button
              ref={accountMenuTriggerRef}
              type="button"
              className="gsaa-account-menu-trigger"
              aria-haspopup="menu"
              aria-expanded={accountMenuOpen}
              aria-controls="gsaa-supporter-account-menu"
              onClick={() => {
                setAuthPopoverOpen(false);
                setAccountMenuOpen((value) => !value);
              }}
            >
              <span className="gsaa-v3-account-identity" aria-label={supporterHeaderCopy.welcome}>
                <span className="gsaa-v3-account-eyebrow">{supporterHeaderCopy.welcome}</span>
                <strong className="gsaa-v3-account-name">{supporterSession.name}</strong>
                <span className="gsaa-v3-account-email" title={supporterSession.email}>{supporterSession.email}</span>
              </span>
              <ChevronDown aria-hidden="true" size={17} />
            </button>
            {accountMenuOpen && (
              <div ref={accountMenuRef} id="gsaa-supporter-account-menu" className="gsaa-account-menu" role="menu" aria-label={supporterHeaderCopy.account}>
                {supporterSession.dashboardPath && (
                  <a role="menuitem" href={supporterSession.dashboardPath}><LayoutDashboard size={17} /> {supporterHeaderCopy.dashboard}</a>
                )}
                <a role="menuitem" href="https://voiceup.live/"><Home size={17} /> {supporterHeaderCopy.home}</a>
                {supporterSession.dashboardPath && (
                  <a role="menuitem" href={`${supporterSession.dashboardPath}#certificates`}><Award size={17} /> {supporterHeaderCopy.certificates}</a>
                )}
                <button role="menuitem" type="button" disabled={supporterSignOutBusy} onClick={() => void signOutFromCampaign()}>
                  <LogOut aria-hidden="true" size={17} /> {supporterHeaderCopy.signOut}
                </button>
              </div>
            )}
          </div>
        ) : !supporterSessionChecking ? (
          <div className="gsaa-auth-popover-anchor">
            <button
              ref={signInTriggerRef}
              type="button"
              className="public-campaign-sign-in"
              aria-haspopup="dialog"
              aria-expanded={authPopoverOpen}
              aria-controls="gsaa-header-auth-popover"
              onClick={() => {
                setAccountMenuOpen(false);
                setAuthPopoverOpen((value) => !value);
              }}
            >
              <LogIn aria-hidden="true" size={17} />
              <span>{t("account.login.campaignSignIn")}</span>
            </button>
            {authPopoverOpen && (
              <div
                ref={authPopoverRef}
                id="gsaa-header-auth-popover"
                className="gsaa-auth-popover"
                role="dialog"
                aria-modal="false"
                aria-labelledby="gsaa-header-auth-title"
              >
                <div className="gsaa-auth-popover-heading">
                  <strong id="gsaa-header-auth-title">{t("account.login.campaignTitle")}</strong>
                  <button type="button" aria-label="Close sign in" onClick={() => {
                    setAuthPopoverOpen(false);
                    signInTriggerRef.current?.focus();
                  }}><X size={18} /></button>
                </div>
                <CampaignInlineAuthPanel
                  active
                  context={{ campaignId: campaign.id, campaignSlug: campaign.slug }}
                  routingToken={supporterRoutingPrecheck?.routingToken}
                  initialRoute={undefined}
                  onAuthenticated={() => {
                    setSupporterSessionChecking(true);
                    setSupporterSessionRevision((value) => value + 1);
                  }}
                  onContinueSigning={() => {
                    setVerificationOutcome(null);
                    setParticipationMode("support");
                    setWizardStep("profile");
                    setAuthPopoverOpen(false);
                  }}
                />
              </div>
            )}
          </div>
        ) : null}
        <LanguageSwitcher />
      </div>
  );

  return (
    <>
      {premiumPresentation && (
        <header className="gsaa-v3-fixed-header" aria-label="Campaign account header">
          <div className="gsaa-v3-fixed-header-inner">
            <div className="gsaa-v3-header-brand">
              <img src={premiumPresentation.logoAsset} alt="" aria-hidden="true" />
              <strong title={displayCampaign.title}>{displayCampaign.title}</strong>
            </div>
            {accountToolbar}
          </div>
        </header>
      )}
    <section
      className="public-layout public-campaign-modern public-campaign-v2"
      data-wizard-step={wizardStep}
      data-goudhan-experience={isGoudhanExperience ? "true" : undefined}
      data-gaumata-host={isGaumataCampaignExperience ? "true" : undefined}
      data-premium-presentation={premiumPresentation?.kind}
    >
      {!premiumPresentation && accountToolbar}
      <div className="public-story-column">
        <article
          className={`public-campaign-v2-hero ${campaignHeroArtwork ? "campaign-page campaign-page-with-media" : "campaign-page"}`}
          style={{
            backgroundImage: displayCampaign.heroImage
              ? !premiumPresentation
                ? `linear-gradient(135deg, rgba(4, 13, 31, 0.82), rgba(4, 13, 31, 0.46)), url(${campaignHeroArtwork})`
                : undefined
              : undefined,
            backgroundPosition: campaign.heroImagePosition,
            backgroundSize: `${campaign.heroImageZoom}%`
          }}
        >
          <div className="public-hero-surface public-campaign-v2-hero-surface">
            <div className="public-campaign-v2-hero-main">
            <div className="public-hero-content">
              {premiumPresentation ? (
                <div className="public-premium-brand" aria-label={publicOrganizationLabel || undefined}>
                  <img
                    src={premiumPresentation.logoAsset}
                    alt={`${displayCampaign.title} logo`}
                  />
                  {isGaumataCampaignExperience && (
                    <small className="public-premium-attribution">{t("goudhanCampaign.poweredByVoiceUp")}</small>
                  )}
                </div>
              ) : isGoudhanExperience ? (
                <div
                  className="goudhan-public-brand public-premium-brand"
                  aria-label={publicOrganizationLabel || undefined}
                >
                  <img
                    src="/brands/gau-samman/campaign-logo.png"
                    alt={`${displayCampaign.title} logo`}
                  />
                  <span>{t("goudhanCampaign.tagline")}</span>
                  {isGaumataCampaignExperience && (
                    <small className="goudhan-powered-by public-premium-attribution">{t("goudhanCampaign.poweredByVoiceUp")}</small>
                  )}
                </div>
              ) : null}
              {!premiumPresentation && (
                <div className="public-hero-kicker">
                  <span className="eyebrow">
                    {isGoudhanExperience
                      ? t("public.movement.publicCampaign")
